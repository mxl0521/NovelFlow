# Copy this file to .env only for local development, then set your own key.
# Never place this key in web-ui/src or commit a real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Optional: use an OpenAI-compatible gateway.
OPENAI_BASE_URL=
# Optional: define multiple profiles. Each key_env points to a server-side environment variable.
# NOVELFLOW_MODEL_PROFILES_JSON=[{"id":"gpt56","name":"GPT-5.6","provider":"OpenAI","model":"gpt-5.6","key_env":"OPENAI_API_KEY","base_url":""},{"id":"deepseek","name":"DeepSeek","provider":"DeepSeek","model":"deepseek-chat","key_env":"DEEPSEEK_API_KEY","base_url":"https://api.deepseek.com/v1"}]
DEEPSEEK_API_KEY=
NOVELFLOW_API_HOST=127.0.0.1
NOVELFLOW_API_PORT=8787
# Local neural vector memory. Set to 0 to use keyword retrieval only.
NOVELFLOW_VECTOR_MEMORY=1

# Optional cloud persistence. Run supabase/schema.sql first.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for portable encrypted model keys in cloud mode.
# Use a long random string and keep it only in server env vars.
NOVELFLOW_SECRET_KEY=
# Enable account isolation for customer use.
NOVELFLOW_REQUIRE_AUTH=1
# Temporary tenant owner UUID for the current single-user cloud mode.
# This must be a UUID that exists in Supabase Auth; user login will replace it.
NOVELFLOW_TENANT_ID=
